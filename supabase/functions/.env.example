# Copy to supabase/functions/.env and fill in the real value.
# Never commit supabase/functions/.env itself (it's gitignored).
API_FOOTBALL_KEY=
# Paystack test secret key (sk_test_...) from dashboard.paystack.com, Settings > API Keys & Webhooks.
PAYSTACK_SECRET_KEY=
# Only set this in production, e.g. https://astro.football, so Paystack only ever sends players back there.
APP_URL=
