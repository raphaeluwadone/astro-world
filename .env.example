# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Never commit .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shows "Continue with Google" once the provider is set up in Supabase (see supabase/config.toml).
VITE_AUTH_GOOGLE=false
